# Compose/runtime wiring
COMPOSE_PROJECT_NAME=bro-btc
BRO_ASSET=btc
BRO_MODE=paper
BRO_DOCKER_MODE=1
BRO_CONFIG_PATH=./configs/profiles/paper_universal.yaml
BRO_LOG_DIR=./logs_exec
BRO_DATA_DIR=./data
BRO_METRICS_PORT=9108
BRO_NOFILE_SOFT=65536
BRO_NOFILE_HARD=65536
BRO_NPROC_LIMIT=4096

# Live trading credentials
POLYMARKET_PRIVATE_KEY=replace_me
POLYMARKET_FUNDER=0xreplace_me
SECURITY_ACK=YES

# Optional alert webhook (Slack/Discord/custom receiver)
POLY_BOT_ALERT_WEBHOOK=https://example.com/webhook

# Optional Telegram alerts (used when alerts.telegram_enabled=true)
POLY_BOT_TELEGRAM_TOKEN=replace_me
POLY_BOT_TELEGRAM_CHAT_ID=replace_me
